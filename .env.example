# ─────────────────────────────────────────────────────────────
# Copia este archivo a .env y rellena con los valores de tu
# proyecto de Supabase (Project Settings → API).
# ─────────────────────────────────────────────────────────────

# URL del proyecto Supabase, p.ej. https://xxxxxxxx.supabase.co
PUBLIC_SUPABASE_URL=

# Clave pública "anon" (segura para el navegador / login).
PUBLIC_SUPABASE_ANON_KEY=

# Clave "service_role" (SECRETA). Solo se usa en el servidor para
# insertar respuestas y leer resultados en el panel. Nunca la
# expongas en el cliente ni la subas al repositorio.
SUPABASE_SERVICE_ROLE_KEY=

---
import type { Grabacion } from '@/lib/config';
export interface Props {
  grabacion: Grabacion;
  /**
   * Etiqueta a mostrar. El formulario pasa aquí la posición dentro del bloque
   * («Grabación 1», «Grabación 2»…) para no revelar el nº global ni la ciudad
   * del habla, que el participante no debe conocer.
   */
  titulo?: string;
}
const { grabacion, titulo } = Astro.props;
const rotulo = titulo ?? grabacion.titulo;

// Deduce el tipo MIME a partir de la extensión para que el navegador sepa
// qué códec espera (importante con .ogg/.opus de WhatsApp).
function mime(url: string): string | undefined {
  const clean = url.split('?')[0].toLowerCase();
  if (clean.endsWith('.ogg') || clean.endsWith('.opus')) return 'audio/ogg; codecs=opus';
  if (clean.endsWith('.mp3') || clean.endsWith('.mpeg') || clean.endsWith('.mpga'))
    return 'audio/mpeg';
  if (clean.endsWith('.m4a') || clean.endsWith('.aac') || clean.endsWith('.mp4')) return 'audio/mp4';
  if (clean.endsWith('.wav')) return 'audio/wav';
  if (clean.endsWith('.webm')) return 'audio/webm';
  return undefined;
}

// Todas las candidatas: las declaradas en el catálogo (mismo nombre con
// distintas extensiones) más el fallback manual, sin repetir.
const fuentes = [
  ...(grabacion.fuentes ?? [grabacion.url]),
  grabacion.urlFallback,
].filter((u, i, arr): u is string => Boolean(u) && arr.indexOf(u) === i);

const soundcloudSrc =
  grabacion.tipo === 'soundcloud' && grabacion.url
    ? `https://w.soundcloud.com/player/?url=${encodeURIComponent(
        grabacion.url
      )}&color=%231f66f0&auto_play=false&hide_related=true&show_comments=false&show_user=false&show_reposts=false&visual=false`
    : null;
---

<div class="rounded-2xl border border-brand-100 bg-white p-4 shadow-sm">
  <div class="mb-3 flex items-center gap-2 text-brand-800">
    <span class="flex h-8 w-8 items-center justify-center rounded-full bg-brand-600 text-white">
      🎧
    </span>
    <span class="font-semibold">{rotulo}</span>
  </div>

  {
    grabacion.tipo === 'audio' && grabacion.url && (
      <>
        <audio controls preload="metadata" class="audio-grabacion w-full">
          {fuentes.map((src) => <source src={src} type={mime(src)} />)}
          Tu navegador no admite la reproducción de este audio.
        </audio>
        <p
          class="audio-error mt-2 hidden rounded-xl border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-800"
          role="alert"
        >
          No se ha podido cargar este audio. Comprueba tu conexión y vuelve a
          intentarlo; si el problema persiste, avisa al investigador.
        </p>
      </>
    )
  }

  {soundcloudSrc && (
    <iframe
      width="100%"
      height="120"
      scrolling="no"
      frameborder="no"
      allow="autoplay"
      src={soundcloudSrc}
      title={rotulo}
    ></iframe>
  )}

  {
    !grabacion.url && (
      <div class="flex items-center gap-3 rounded-xl border border-dashed border-slate-300 bg-slate-50 px-4 py-3 text-sm text-slate-500">
        <span class="text-lg">⏳</span>
        <span>
          Audio pendiente de subir. Configura su URL en{' '}
          <code class="rounded bg-slate-200 px-1">src/lib/config.ts</code>.
        </span>
      </div>
    )
  }
</div>

<script>
  // Un <audio> con varias <source> solo dispara "error" en el propio elemento
  // cuando TODAS han fallado (404 o formato no soportado): ahí avisamos.
  document.querySelectorAll('audio.audio-grabacion').forEach((audio) => {
    audio.addEventListener('error', () => {
      const aviso = audio.parentElement?.querySelector('.audio-error');
      if (aviso) aviso.classList.remove('hidden');
      console.error(
        '[audio] Ninguna fuente se pudo cargar:',
        Array.from(audio.querySelectorAll('source')).map((s) => s.getAttribute('src'))
      );
    });
  });
</script>

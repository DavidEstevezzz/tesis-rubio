---
import Layout from '@/layouts/Layout.astro';
---

<Layout title="¡Gracias! · Estudio Sociolingüístico">
  <main class="flex min-h-screen items-center justify-center px-6">
    <div class="max-w-md text-center">
      <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-full bg-green-100 text-4xl">
        ✅
      </div>
      <h1 class="mt-6 font-display text-3xl font-extrabold text-brand-950">¡Muchas gracias!</h1>
      <p class="mt-3 text-slate-600">
        Tu respuesta se ha registrado correctamente. Tu colaboración es muy
        valiosa para esta investigación sobre las actitudes lingüísticas.
      </p>
      <a href="/" class="mt-8 inline-flex rounded-full bg-brand-600 px-6 py-3 font-semibold text-white transition hover:bg-brand-700">
        Volver al inicio
      </a>
    </div>
  </main>
</Layout>

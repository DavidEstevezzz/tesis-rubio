---
import Layout from '@/layouts/Layout.astro';
import PasoGrabacion from '@/components/PasoGrabacion.astro';
import TablaFrecuencia from '@/components/TablaFrecuencia.astro';
import {
  GRABACIONES,
  GENEROS,
  NIVELES_EDUCATIVOS,
  NIVELES_ESPANOL,
  METODOS_ESTUDIO,
  OTROS_IDIOMAS,
  NIVELES_IDIOMA,
} from '@/lib/config';

const totalGrab = GRABACIONES.length;
---

<Layout title="Formulario · Estudio Sociolingüístico">
  <main class="mx-auto max-w-3xl px-4 py-8 sm:px-6">
    <header class="mb-6">
      <a href="/" class="text-sm text-brand-600 hover:underline">← Inicio</a>
      <h1 class="mt-2 font-display text-3xl font-extrabold text-brand-950">
        Formulario sobre actitudes hacia la variedad del español europeo
      </h1>
      <p class="mt-1 text-slate-500">
        Este estudio investiga cómo percibe el hispanismo marroquí (docentes y
        estudiantes) las distintas variedades del español europeo. Escucharás
        varias grabaciones y compartirás tus impresiones. No hay respuestas
        correctas ni incorrectas: solo nos interesa <strong>tu opinión</strong>.
      </p>
    </header>

    <!-- Barra de progreso -->
    <div class="sticky top-0 z-20 -mx-4 mb-6 bg-slate-50/90 px-4 py-3 backdrop-blur sm:mx-0 sm:rounded-xl sm:px-4">
      <div class="flex items-center justify-between text-sm font-medium text-slate-500">
        <span id="stepLabel">Datos personales</span>
        <span><span id="stepNum">1</span> / <span id="stepTotal"></span></span>
      </div>
      <div class="mt-2 h-2 w-full overflow-hidden rounded-full bg-slate-200">
        <div id="progressBar" class="h-full w-0 rounded-full bg-gradient-to-r from-brand-500 to-accent-500 transition-all duration-300"></div>
      </div>
    </div>

    <form id="estudioForm" novalidate>
      <!-- ═══ PASO 1 · DATOS PERSONALES ═══ -->
      <section class="step" data-step-label="Datos personales">
        <div class="rounded-2xl border border-slate-100 bg-white p-5 shadow-sm sm:p-7">
          <h2 class="font-display text-xl font-bold text-brand-900">Datos personales</h2>

          <div class="field">
            <label class="field-title" for="email">
              Correo electrónico<span class="req">*</span>
            </label>
            <p class="field-help">
              Solo se usa para evitar respuestas duplicadas. No se publicará ni se
              asociará a tus respuestas en los resultados.
            </p>
            <input id="email" name="email" type="email" class="input" placeholder="tucorreo@ejemplo.com" required />
          </div>

          <div class="field">
            <h3 class="field-title">Género<span class="req">*</span></h3>
            <div class="pills">
              {GENEROS.map((g) => (
                <label class="pill">
                  <input type="radio" name="genero" value={g} required class="peer sr-only" data-toggle-otro={g === 'Otro' ? 'genero_otro' : null} />
                  <span>{g}</span>
                </label>
              ))}
            </div>
            <input id="genero_otro" name="genero_otro" type="text" class="input mt-2 hidden" placeholder="Especifica…" />
          </div>

          <div class="grid gap-5 sm:grid-cols-2">
            <div class="field">
              <label class="field-title" for="edad">Edad<span class="req">*</span></label>
              <input id="edad" name="edad" type="number" min="1" max="120" class="input" placeholder="p. ej., 23" required />
            </div>
            <div class="field">
              <label class="field-title" for="lenguas_maternas">Lengua(s) materna(s)<span class="req">*</span></label>
              <input id="lenguas_maternas" name="lenguas_maternas" type="text" class="input" placeholder="Indica si hay varias" required />
            </div>
            <div class="field">
              <label class="field-title" for="ciudad_nacimiento">Ciudad de nacimiento<span class="req">*</span></label>
              <input id="ciudad_nacimiento" name="ciudad_nacimiento" type="text" class="input" required />
            </div>
            <div class="field">
              <label class="field-title" for="ciudad_residencia">Ciudad de residencia<span class="req">*</span></label>
              <input id="ciudad_residencia" name="ciudad_residencia" type="text" class="input" required />
            </div>
          </div>

          <!-- Otros idiomas y niveles -->
          <div class="field">
            <h3 class="field-title">Otros idiomas y sus niveles</h3>
            <p class="field-help">Marca solo los idiomas que hables.</p>
            <div class="space-y-2">
              {OTROS_IDIOMAS.map((idioma) => (
                <div class="idioma-row">
                  <span class="idioma-name">{idioma}</span>
                  <div class="chips">
                    {NIVELES_IDIOMA.map((nivel) => (
                      <label class="chip">
                        <input type="radio" name={`idioma_${idioma}`} value={nivel} class="peer sr-only" />
                        <span>{nivel}</span>
                      </label>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </div>

          <div class="grid gap-5 sm:grid-cols-2">
            <div class="field">
              <h3 class="field-title">¿Estudias?<span class="req">*</span></h3>
              <div class="pills">
                <label class="pill"><input type="radio" name="estudia" value="si" required class="peer sr-only" /><span>Sí</span></label>
                <label class="pill"><input type="radio" name="estudia" value="no" required class="peer sr-only" /><span>No</span></label>
              </div>
            </div>
            <div class="field">
              <h3 class="field-title">¿Trabajas?<span class="req">*</span></h3>
              <div class="pills">
                <label class="pill"><input type="radio" name="trabaja" value="si" required class="peer sr-only" /><span>Sí</span></label>
                <label class="pill"><input type="radio" name="trabaja" value="no" required class="peer sr-only" /><span>No</span></label>
              </div>
            </div>
          </div>

          <div class="conditional hidden" data-show-when="estudia" data-show-value="si">
            <div class="field">
              <label class="field-title" for="que_estudias">¿Qué estudias?<span class="req">*</span></label>
              <input id="que_estudias" name="que_estudias" type="text" class="input" placeholder="Describe detalladamente" required />
            </div>
          </div>

          <div class="conditional hidden" data-show-when="trabaja" data-show-value="si">
            <div class="field">
              <label class="field-title" for="cual_trabajo">¿Cuál es tu trabajo?<span class="req">*</span></label>
              <input id="cual_trabajo" name="cual_trabajo" type="text" class="input" placeholder="Describe detalladamente" required />
            </div>
          </div>

          <div class="field">
            <label class="field-title" for="nivel_educativo">Nivel educativo<span class="req">*</span></label>
            <select id="nivel_educativo" name="nivel_educativo" class="input" required>
              <option value="" disabled selected>Selecciona…</option>
              {NIVELES_EDUCATIVOS.map((n) => <option value={n}>{n}</option>)}
            </select>
          </div>

          <div class="field">
            <label class="field-title" for="anios_estudio_espanol">Años de estudio del español<span class="req">*</span></label>
            <input id="anios_estudio_espanol" name="anios_estudio_espanol" type="number" min="0" max="99" class="input" required />
          </div>

          <div class="field">
            <h3 class="field-title">Métodos de estudio del español<span class="req">*</span></h3>
            <div class="pills" data-required-group="metodos_estudio">
              {METODOS_ESTUDIO.map((m) => (
                <label class="pill">
                  <input type="checkbox" name="metodos_estudio" value={m} class="peer sr-only" />
                  <span>{m}</span>
                </label>
              ))}
            </div>
          </div>

          <div class="field">
            <label class="field-title" for="metodos_ejemplos">
              Menciona ejemplos concretos de los métodos que utilizas para aprender y
              practicar español<span class="req">*</span>
            </label>
            <p class="field-help">
              (Hablar o escribir con un amigo, ver telenovelas en español,
              interactuar con turistas, leer libros, preparar clases, escuchar
              música, etc.)
            </p>
            <textarea id="metodos_ejemplos" name="metodos_ejemplos" class="input" required></textarea>
          </div>

          <div class="field">
            <label class="field-title" for="nivel_espanol">Nivel en español<span class="req">*</span></label>
            <select id="nivel_espanol" name="nivel_espanol" class="input" required>
              <option value="" disabled selected>Selecciona…</option>
              {NIVELES_ESPANOL.map((n) => <option value={n}>{n}</option>)}
            </select>
          </div>

          <div class="grid gap-5 sm:grid-cols-2">
            <div class="field">
              <h3 class="field-title">¿Tienes familia en España?<span class="req">*</span></h3>
              <div class="pills">
                <label class="pill"><input type="radio" name="familia_espana" value="si" required class="peer sr-only" /><span>Sí</span></label>
                <label class="pill"><input type="radio" name="familia_espana" value="no" required class="peer sr-only" /><span>No</span></label>
              </div>
            </div>
            <div class="field">
              <h3 class="field-title">¿Has visitado España?<span class="req">*</span></h3>
              <div class="pills">
                <label class="pill"><input type="radio" name="visitado_espana" value="si" required class="peer sr-only" /><span>Sí</span></label>
                <label class="pill"><input type="radio" name="visitado_espana" value="no" required class="peer sr-only" /><span>No</span></label>
              </div>
            </div>
          </div>

          <div class="conditional hidden" data-show-when="familia_espana" data-show-value="si">
            <div class="field">
              <label class="field-title" for="familia_espana_zonas">Indica las zonas<span class="req">*</span></label>
              <input id="familia_espana_zonas" name="familia_espana_zonas" type="text" class="input" required />
            </div>
          </div>

          <div class="conditional hidden" data-show-when="visitado_espana" data-show-value="si">
            <TablaFrecuencia name="visitado_espana_tiempo" />
            <div class="field">
              <label class="field-title" for="visitado_espana_zonas">Señala las zonas visitadas<span class="req">*</span></label>
              <input id="visitado_espana_zonas" name="visitado_espana_zonas" type="text" class="input" required />
            </div>
          </div>

          <div class="field">
            <label class="field-title" for="mejor_region_opinion">
              En tu opinión, ¿en qué región o zona de España se habla mejor? Justifica
              tu respuesta<span class="req">*</span>
            </label>
            <textarea id="mejor_region_opinion" name="mejor_region_opinion" class="input" required></textarea>
          </div>

          <div class="field">
            <h3 class="field-title">¿Has visitado otro(s) país(es) hispanohablante(s)?<span class="req">*</span></h3>
            <div class="pills">
              <label class="pill"><input type="radio" name="visitado_otros_paises" value="si" required class="peer sr-only" /><span>Sí</span></label>
              <label class="pill"><input type="radio" name="visitado_otros_paises" value="no" required class="peer sr-only" /><span>No</span></label>
            </div>
          </div>

          <div class="conditional hidden" data-show-when="visitado_otros_paises" data-show-value="si">
            <div class="field">
              <label class="field-title" for="visitado_otros_paises_cuales">Indica cuál(es)<span class="req">*</span></label>
              <input id="visitado_otros_paises_cuales" name="visitado_otros_paises_cuales" type="text" class="input" required />
            </div>
            <TablaFrecuencia name="visitado_otros_paises_tiempo" />
          </div>
        </div>
      </section>

      <!-- ═══ PASOS 2..N+1 · GRABACIONES ═══ -->
      {
        GRABACIONES.map((g, i) => (
          <div class="rounded-2xl border border-slate-100 bg-white p-5 shadow-sm sm:p-7 step-wrapper hidden">
            <PasoGrabacion grabacion={g} indice={i + 1} total={totalGrab} />
          </div>
        ))
      }

      <!-- Navegación -->
      <div class="sticky bottom-0 z-20 mt-6 flex items-center justify-between gap-3 border-t border-slate-200 bg-slate-50/95 py-4 backdrop-blur">
        <button type="button" id="btnPrev" class="rounded-full border border-slate-300 bg-white px-6 py-2.5 font-semibold text-slate-600 transition hover:bg-slate-100 disabled:opacity-40" disabled>
          ← Anterior
        </button>
        <button type="button" id="btnNext" class="rounded-full bg-brand-600 px-8 py-2.5 font-semibold text-white shadow-lg shadow-brand-600/30 transition hover:bg-brand-700">
          Siguiente →
        </button>
        <button type="submit" id="btnSubmit" class="hidden rounded-full bg-accent-500 px-8 py-2.5 font-semibold text-white shadow-lg shadow-accent-500/30 transition hover:bg-accent-600">
          Enviar respuestas
        </button>
      </div>

      <!-- Mensaje de estado -->
      <div id="formMsg" class="hidden rounded-xl border p-4 text-sm"></div>
    </form>
  </main>

  <script>
    // ── Stepper multipágina ──────────────────────────────────────────────
    const form = document.getElementById('estudioForm') as HTMLFormElement;
    // Cada paso es un .step directo o un .step dentro de .step-wrapper
    const steps = Array.from(form.querySelectorAll('.step')) as HTMLElement[];
    const wrappers = steps.map(
      (s) => (s.closest('.step-wrapper') as HTMLElement) ?? s
    );
    const total = steps.length;
    let current = 0;

    const btnPrev = document.getElementById('btnPrev') as HTMLButtonElement;
    const btnNext = document.getElementById('btnNext') as HTMLButtonElement;
    const btnSubmit = document.getElementById('btnSubmit') as HTMLButtonElement;
    const progressBar = document.getElementById('progressBar') as HTMLElement;
    const stepLabel = document.getElementById('stepLabel') as HTMLElement;
    const stepNum = document.getElementById('stepNum') as HTMLElement;
    const stepTotal = document.getElementById('stepTotal') as HTMLElement;
    const formMsg = document.getElementById('formMsg') as HTMLElement;
    stepTotal.textContent = String(total);

    function render() {
      wrappers.forEach((w, i) => w.classList.toggle('hidden', i !== current));
      const label = steps[current].dataset.stepLabel ?? '';
      stepLabel.textContent = label;
      stepNum.textContent = String(current + 1);
      progressBar.style.width = `${((current + 1) / total) * 100}%`;
      btnPrev.disabled = current === 0;
      const last = current === total - 1;
      btnNext.classList.toggle('hidden', last);
      btnSubmit.classList.toggle('hidden', !last);
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function clearErrors(step: HTMLElement) {
      step.querySelectorAll('.field-error').forEach((el) => el.classList.remove('field-error'));
      step.querySelectorAll('.row-error').forEach((el) => el.classList.remove('row-error'));
      step.querySelectorAll('.js-error').forEach((el) => el.remove());
    }

    // Localiza el "grupo" concreto que hay que resaltar (una fila de la escala,
    // un grupo de botones, la barra de proximidad, una fila de idioma…).
    function groupOf(el: Element): HTMLElement | null {
      return (
        (el.closest('.pills') as HTMLElement) ||
        (el.closest('fieldset.diferencial-row') as HTMLElement) ||
        (el.closest('.prox-group') as HTMLElement) ||
        (el.closest('tr') as HTMLElement) ||
        (el.closest('.field') as HTMLElement)
      );
    }

    // Añade (una sola vez por apartado) un mensaje de aviso bajo el .field.
    function addFieldMessage(el: Element, text: string) {
      const field = (el.closest('.field') as HTMLElement) || (el.parentElement as HTMLElement);
      if (!field) return;
      field.classList.add('field-error');
      if (!field.querySelector('.js-error')) {
        const p = document.createElement('p');
        p.className = 'error-msg js-error';
        p.style.display = 'block';
        p.innerHTML = `<span aria-hidden="true">⚠</span> ${text}`;
        field.appendChild(p);
      }
    }

    function validateStep(step: HTMLElement): boolean {
      clearErrors(step);
      let ok = true;
      let firstInvalid: HTMLElement | null = null;
      const seenRadios = new Set<string>();

      step.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('[required]').forEach((el) => {
        // Ignora los campos dentro de un bloque condicional que está oculto.
        if (el.closest('.conditional.hidden')) return;
        if (el instanceof HTMLInputElement && el.type === 'radio') {
          if (seenRadios.has(el.name)) return;
          seenRadios.add(el.name);
          const checked = step.querySelector(`input[name="${CSS.escape(el.name)}"]:checked`);
          if (!checked) {
            ok = false;
            const group = groupOf(el);
            group?.classList.add('row-error');
            addFieldMessage(el, 'Falta por responder.');
            firstInvalid = firstInvalid || group || (el as HTMLElement);
          }
        } else if (!el.value.trim()) {
          ok = false;
          el.classList.add('field-error');
          addFieldMessage(el, 'Completa este campo.');
          firstInvalid = firstInvalid || (el as HTMLElement);
        }
      });

      // Grupos de checkbox obligatorios (métodos de estudio)
      step.querySelectorAll<HTMLElement>('[data-required-group]').forEach((group) => {
        const name = group.dataset.requiredGroup!;
        const any = step.querySelector(`input[name="${CSS.escape(name)}"]:checked`);
        if (!any) {
          ok = false;
          group.classList.add('row-error');
          addFieldMessage(group, 'Selecciona al menos una opción.');
          firstInvalid = firstInvalid || group;
        }
      });

      if (firstInvalid) {
        (firstInvalid as HTMLElement).scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
      return ok;
    }

    // Limpia el error en cuanto el usuario responde a lo que faltaba.
    function onFix(e: Event) {
      const t = e.target as HTMLElement;
      if (!t || !t.matches?.('input, select, textarea')) return;
      const field = t.closest('.field') as HTMLElement | null;
      if (!field) return;
      const input = t as HTMLInputElement;
      if (input.type === 'radio' || input.type === 'checkbox') {
        const name = input.getAttribute('name');
        if (name && field.querySelector(`input[name="${CSS.escape(name)}"]:checked`)) {
          groupOf(input)?.classList.remove('row-error');
        }
      } else if (input.value.trim()) {
        input.classList.remove('field-error');
      }
      // Si ya no queda nada marcado en el apartado, retira el aviso.
      if (!field.querySelector('.row-error, .input.field-error')) {
        field.classList.remove('field-error');
        field.querySelectorAll('.js-error').forEach((n) => n.remove());
      }
    }
    form.addEventListener('input', onFix, true);
    form.addEventListener('change', onFix, true);

    btnNext.addEventListener('click', () => {
      if (!validateStep(steps[current])) return;
      if (current < total - 1) {
        current++;
        render();
      }
    });
    btnPrev.addEventListener('click', () => {
      if (current > 0) {
        current--;
        render();
      }
    });

    // ── Bloques condicionales (aparecen según la respuesta a una pregunta) ──
    // Uso: <div class="conditional hidden" data-show-when="nombre" data-show-value="si">
    form.querySelectorAll<HTMLElement>('.conditional[data-show-when]').forEach((block) => {
      const name = block.dataset.showWhen!;
      const wanted = block.dataset.showValue ?? 'si';
      const update = () => {
        const checked = form.querySelector<HTMLInputElement>(
          `input[name="${CSS.escape(name)}"]:checked`
        );
        const show = !!checked && checked.value === wanted;
        block.classList.toggle('hidden', !show);
        if (!show) {
          // Al ocultarse, limpia valores y errores para no enviar datos ni
          // bloquear la validación con campos invisibles.
          block.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('input, select, textarea').forEach((i) => {
            if (i instanceof HTMLInputElement && (i.type === 'radio' || i.type === 'checkbox')) i.checked = false;
            else i.value = '';
          });
          block.querySelectorAll('.field-error, .row-error').forEach((e) =>
            e.classList.remove('field-error', 'row-error')
          );
          block.querySelectorAll('.js-error').forEach((e) => e.remove());
        }
      };
      form.querySelectorAll<HTMLInputElement>(`input[name="${CSS.escape(name)}"]`).forEach((r) =>
        r.addEventListener('change', update)
      );
      update();
    });

    // Campo "Otro" del género
    form.querySelectorAll<HTMLInputElement>('input[data-toggle-otro]').forEach((radio) => {
      const targetId = radio.dataset.toggleOtro!;
      const target = document.getElementById(targetId) as HTMLInputElement;
      form.querySelectorAll<HTMLInputElement>(`input[name="${radio.name}"]`).forEach((r) => {
        r.addEventListener('change', () => {
          const show = radio.checked;
          target.classList.toggle('hidden', !show);
          if (!show) target.value = '';
        });
      });
    });

    // ── Envío ────────────────────────────────────────────────────────────
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      // Validar todos los pasos
      for (let i = 0; i < total; i++) {
        if (!validateStep(steps[i])) {
          current = i;
          render();
          return;
        }
      }

      btnSubmit.disabled = true;
      btnSubmit.textContent = 'Enviando…';
      formMsg.className = 'hidden';

      const data = Object.fromEntries(new FormData(form).entries());
      // metodos_estudio es múltiple → recogerlo aparte
      (data as any).metodos_estudio = Array.from(
        form.querySelectorAll<HTMLInputElement>('input[name="metodos_estudio"]:checked')
      ).map((c) => c.value);

      try {
        const res = await fetch('/api/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });
        const json = await res.json();
        if (!res.ok) throw new Error(json.error || 'Error al enviar.');
        window.location.href = '/gracias';
      } catch (err: any) {
        formMsg.className = 'rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-700';
        formMsg.textContent = err.message || 'Ha ocurrido un error. Inténtalo de nuevo.';
        btnSubmit.disabled = false;
        btnSubmit.textContent = 'Enviar respuestas';
      }
    });

    render();
  </script>
</Layout>

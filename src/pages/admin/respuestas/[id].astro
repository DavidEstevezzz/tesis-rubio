---
import Layout from '@/layouts/Layout.astro';
import AdminNav from '@/components/AdminNav.astro';
import { getServiceClient } from '@/lib/supabase';
import { ESCALA_VOZ, ESCALA_PERSONA, ESCALA_CULTURA } from '@/lib/config';

const user = Astro.locals.user;
const { id } = Astro.params;
const supabase = getServiceClient();

const { data: p } = await supabase.from('participantes').select('*').eq('id', id).maybeSingle();
if (!p) return Astro.redirect('/admin/respuestas');

const { data: valoraciones } = await supabase
  .from('valoraciones')
  .select('*')
  .eq('participante_id', id)
  .order('grabacion');

const fmt = (b: boolean | null) => (b === true ? 'Sí' : b === false ? 'No' : '—');
const escalaTxt = (obj: Record<string, number>, items: { id: string; positivo: string }[]) =>
  items.map((it) => `${it.positivo}: ${obj?.[it.id] ?? '—'}`).join(' · ');

const datos: [string, any][] = [
  ['Versión del formulario (bloque)', p.bloque ?? '—'],
  ['Género', p.genero + (p.genero_otro ? ` (${p.genero_otro})` : '')],
  ['Edad', p.edad],
  ['Ciudad de nacimiento', p.ciudad_nacimiento],
  ['Ciudad de residencia', p.ciudad_residencia],
  ['Lenguas maternas', p.lenguas_maternas],
  ['Otros idiomas', Object.entries(p.otros_idiomas ?? {}).map(([k, v]) => `${k}: ${v}`).join(', ') || '—'],
  ['¿Estudia?', fmt(p.estudia)],
  ['¿Qué estudia?', p.que_estudias],
  ['¿Trabaja?', fmt(p.trabaja)],
  ['¿Cuál es su trabajo?', p.cual_trabajo],
  ['Nivel educativo', p.nivel_educativo],
  ['Años de estudio del español', p.anios_estudio_espanol],
  ['Métodos de estudio', (p.metodos_estudio ?? []).join(', ') || '—'],
  ['Ejemplos de métodos', p.metodos_ejemplos],
  ['Nivel en español', p.nivel_espanol],
  ['¿Familia en España?', fmt(p.familia_espana)],
  ['Zonas (familia en España)', p.familia_espana_zonas],
  ['¿Ha visitado España?', fmt(p.visitado_espana)],
  ['Tiempo de estancia (España)', p.visitado_espana_tiempo],
  ['Zonas visitadas (España)', p.visitado_espana_zonas],
  ['Mejor región (opinión)', p.mejor_region_opinion],
  ['¿Otros países hispanohablantes?', fmt(p.visitado_otros_paises)],
  ['¿Cuáles países?', p.visitado_otros_paises_cuales],
  ['Tiempo de estancia (otros países)', p.visitado_otros_paises_tiempo],
];
---

<Layout title={`Respuesta · ${p.email}`}>
  <div class="min-h-screen bg-slate-100">
    <AdminNav user={user} active="respuestas" />
    <main class="mx-auto max-w-5xl px-4 py-8 sm:px-6">
      <a href="/admin/respuestas" class="text-sm text-brand-600 hover:underline">← Todas las respuestas</a>
      <h1 class="mt-2 font-display text-2xl font-bold text-brand-950">{p.email}</h1>
      <p class="text-sm text-slate-400">
        Registrado el {new Date(p.created_at).toLocaleString('es-ES')}
      </p>

      <section class="mt-6 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
        <h2 class="font-display text-lg font-bold text-brand-900">Datos personales</h2>
        <dl class="mt-4 grid gap-x-8 gap-y-3 sm:grid-cols-2">
          {datos.map(([k, v]) => (
            <div>
              <dt class="text-xs font-medium uppercase tracking-wide text-slate-400">{k}</dt>
              <dd class="text-slate-700">{v ?? '—'}</dd>
            </div>
          ))}
        </dl>
      </section>

      <h2 class="mt-8 font-display text-lg font-bold text-brand-900">
        Valoraciones ({valoraciones?.length ?? 0})
      </h2>
      <div class="mt-4 space-y-4">
        {(valoraciones ?? []).map((v) => (
          <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <div class="flex items-center gap-2">
              <span class="flex h-7 w-7 items-center justify-center rounded-full bg-brand-100 text-sm font-bold text-brand-700">
                {v.grabacion}
              </span>
              <span class="font-semibold text-brand-900">Grabación {v.grabacion}</span>
            </div>
            <dl class="mt-3 grid gap-x-8 gap-y-2 text-sm sm:grid-cols-2">
              <div><dt class="text-slate-400">Voz</dt><dd class="text-slate-700">{escalaTxt(v.escala_voz, ESCALA_VOZ)}</dd></div>
              <div><dt class="text-slate-400">Persona</dt><dd class="text-slate-700">{escalaTxt(v.escala_persona, ESCALA_PERSONA)}</dd></div>
              <div><dt class="text-slate-400">Cultura</dt><dd class="text-slate-700">{escalaTxt(v.escala_cultura, ESCALA_CULTURA)}</dd></div>
              <div><dt class="text-slate-400">Proximidad</dt><dd class="text-slate-700">{v.proximidad ?? '—'} / 5</dd></div>
              <div><dt class="text-slate-400">Puesto / Ingresos / Estudios</dt><dd class="text-slate-700">{v.puesto_trabajo ?? '—'} · {v.nivel_ingresos ?? '—'} · {v.nivel_estudios ?? '—'}</dd></div>
              <div><dt class="text-slate-400">Región percibida</dt><dd class="text-slate-700">{v.region_percibida ?? '—'} {v.conoce_personas_region != null ? `(conoce: ${fmt(v.conoce_personas_region)})` : ''}{v.conoce_personas_region_opinion ? ` — ${v.conoce_personas_region_opinion}` : ''}</dd></div>
              <div class="sm:col-span-2"><dt class="text-slate-400">Gustó / Disgustó</dt><dd class="text-slate-700">👍 {v.aspecto_gustado ?? '—'} — 👎 {v.aspecto_disgustado ?? '—'}</dd></div>
              <div><dt class="text-slate-400">¿Trato diferenciado Mariam/Omar?</dt><dd class="text-slate-700">{fmt(v.trato_diferenciado)}</dd></div>
              <div><dt class="text-slate-400">¿Diferente con jefa mujer?</dt><dd class="text-slate-700">{fmt(v.trato_mujer_diferente)}</dd></div>
              <div class="sm:col-span-2"><dt class="text-slate-400">Actitud según género (texto)</dt><dd class="text-slate-700">{v.actitud_genero_influye ?? '—'}</dd></div>
            </dl>
          </div>
        ))}
      </div>
    </main>
  </div>
</Layout>

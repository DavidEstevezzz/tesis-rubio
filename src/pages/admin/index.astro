---
import Layout from '@/layouts/Layout.astro';
import AdminNav from '@/components/AdminNav.astro';
import { getServiceClient, seleccionarTodo } from '@/lib/supabase';
import { computeStats } from '@/lib/stats';
import { interpretaR } from '@/lib/cruces';

const user = Astro.locals.user;
const supabase = getServiceClient();

// `seleccionarTodo` lee la tabla ENTERA por tandas. Un `select('*')` normal
// se quedaría en las primeras 1 000 filas (el tope de la API de Supabase) y,
// con 200 participantes = 1 200 valoraciones, las gráficas saldrían
// calculadas sobre parte de los datos sin avisar de nada.
const [participantes, valoraciones] = await Promise.all([
  seleccionarTodo((desde, hasta) =>
    supabase.from('participantes').select('*').order('id').range(desde, hasta)
  ),
  seleccionarTodo((desde, hasta) =>
    supabase.from('valoraciones').select('*').order('id').range(desde, hasta)
  ),
]);

const stats = computeStats(participantes, valoraciones);
const hayDatos = stats.resumen.totalParticipantes > 0;

// Formato de las tablas de cruces: los huecos se muestran como «—» y las
// brechas siempre con signo, para que se lea de un vistazo hacia qué zona
// se inclina cada grupo.
const num = (n: number | null | undefined) =>
  n === null || n === undefined ? '\u2014' : n.toFixed(2);
const delta = (n: number | null | undefined) =>
  n === null || n === undefined ? '\u2014' : `${n > 0 ? '+' : ''}${n.toFixed(2)}`;
const claseDelta = (n: number | null | undefined) =>
  n === null || n === undefined
    ? 'text-slate-400'
    : n > 0.05
      ? 'text-brand-700'
      : n < -0.05
        ? 'text-orange-600'
        : 'text-slate-500';
const pct = (n: number | null | undefined) =>
  n === null || n === undefined ? '\u2014' : `${n}%`;
const MEDIDAS_TABLA = [
  { id: 'voz', etiqueta: 'Voz' },
  { id: 'persona', etiqueta: 'Persona' },
  { id: 'cultura', etiqueta: 'Cultura' },
  { id: 'proximidad', etiqueta: 'Proximidad' },
] as const;
---

<Layout title="Resumen · Panel de resultados">
  <div class="min-h-screen bg-slate-100">
    <AdminNav user={user} active="resumen" />

    <main class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
      <h1 class="font-display text-2xl font-bold text-brand-950">Resumen del estudio</h1>

      {
        !hayDatos ? (
          <div class="mt-8 rounded-2xl border border-dashed border-slate-300 bg-white p-12 text-center text-slate-500">
            <div class="text-4xl">📭</div>
            <p class="mt-3 font-medium">Aún no hay respuestas registradas.</p>
            <p class="text-sm">Cuando los participantes completen el formulario, aquí verás las estadísticas.</p>
          </div>
        ) : (
          <>
            <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
              <div class="kpi">
                <span class="kpi-val">{stats.resumen.totalParticipantes}</span>
                <span class="kpi-label">Participantes</span>
              </div>
              <div class="kpi">
                <span class="kpi-val">{stats.resumen.totalValoraciones}</span>
                <span class="kpi-label">Valoraciones de audio</span>
              </div>
              <div class="kpi">
                <span class="kpi-val">{stats.resumen.edadMedia ?? '—'}</span>
                <span class="kpi-label">Edad media</span>
              </div>
              <div class="kpi">
                <span class="kpi-val">{stats.resumen.proximidadMedia}</span>
                <span class="kpi-label">Proximidad media (1-5)</span>
              </div>
            </div>

            <div class="mt-8" id="tabs">
              <div class="tabbar" role="tablist" aria-label="Vistas del estudio">
                <button class="tab" role="tab" data-tab="global" aria-selected="true">
                  🌍 Global · comparativa
                </button>
                <button class="tab tab-cruce" role="tab" data-tab="cruces" aria-selected="false">
                  🔀 Cruces · perfil del participante
                </button>
                {stats.porGrabacion.map((g) => (
                  <button
                    class={`tab ${g.zona === 'meridional' ? 'tab-mer' : 'tab-sep'}`}
                    role="tab"
                    data-tab={g.slug}
                    aria-selected="false"
                  >
                    {g.numero}. {g.ciudad}
                    <span class="tab-n">{g.n}</span>
                  </button>
                ))}
              </div>

              <section class="panel" data-panel="global" role="tabpanel">
                <p class="panel-intro">
                  Todas las gráficas de esta pestaña cruzan las 12 ciudades entre sí.
                  El color distingue la zona dialectal:
                  <span class="chip chip-mer">meridional</span>
                  <span class="chip chip-sep">septentrional</span>.
                </p>

                <div class="grid gap-6 lg:grid-cols-2">
                  <div class="card lg:col-span-2">
                    <h2 class="card-title">Ranking de grabaciones por agradabilidad de la voz</h2>
                    <p class="card-sub">Media global del diferencial semántico de la voz (1 = negativo, 5 = positivo).</p>
                    <div class="chart-box chart-tall"><canvas data-chart="ranking"></canvas></div>
                  </div>

                  <div class="card lg:col-span-2">
                    <h2 class="card-title">Las cuatro medidas, ciudad a ciudad</h2>
                    <p class="card-sub">
                      Voz, persona, cultura y proximidad en la misma gráfica: permite ver si una
                      ciudad bien valorada en la voz lo está también en la persona o en la cultura.
                    </p>
                    <div class="chart-box chart-tall"><canvas data-chart="medias"></canvas></div>
                  </div>

                  <div class="card lg:col-span-2">
                    <h2 class="card-title">Compara un rasgo concreto entre ciudades</h2>
                    <p class="card-sub">
                      Elige un par de adjetivos y compara su media en las 12 grabaciones.
                    </p>
                    <label class="mt-3 block text-sm font-medium text-slate-600">
                      Rasgo
                      <select data-select="rasgo" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm sm:max-w-md"></select>
                    </label>
                    <div class="chart-box"><canvas data-chart="rasgo"></canvas></div>
                  </div>

                  <div class="card">
                    <h2 class="card-title">Perfil de la voz por zona</h2>
                    <p class="card-sub">Hablas meridionales frente a septentrionales, adjetivo a adjetivo.</p>
                    <div class="chart-box chart-tall"><canvas data-chart="radarVoz"></canvas></div>
                  </div>
                  <div class="card">
                    <h2 class="card-title">Perfil de la persona por zona</h2>
                    <p class="card-sub">Media del diferencial semántico de la persona en cada zona.</p>
                    <div class="chart-box chart-tall"><canvas data-chart="radarPersona"></canvas></div>
                  </div>
                  <div class="card">
                    <h2 class="card-title">Perfil de la cultura por zona</h2>
                    <p class="card-sub">Media del diferencial semántico de la cultura en cada zona.</p>
                    <div class="chart-box chart-tall"><canvas data-chart="radarCultura"></canvas></div>
                  </div>

                  <div class="card">
                    <h2 class="card-title">Proximidad con la propia pronunciación</h2>
                    <p class="card-sub">Media por ciudad · 1 = totalmente diferente, 5 = idéntica.</p>
                    <div class="chart-box"><canvas data-chart="proximidadCiudad"></canvas></div>
                  </div>

                  <div class="card">
                    <h2 class="card-title">Aciertos al identificar la región</h2>
                    <p class="card-sub">
                      % de participantes que sitúa el habla en su comunidad autónoma real.
                    </p>
                    <div class="chart-box"><canvas data-chart="acierto"></canvas></div>
                  </div>

                  <div class="card">
                    <h2 class="card-title">Nivel de ingresos percibido por ciudad</h2>
                    <p class="card-sub">Respuestas apiladas: cada barra es una grabación.</p>
                    <div class="chart-box"><canvas data-chart="ingresosCiudad"></canvas></div>
                  </div>
                  <div class="card">
                    <h2 class="card-title">Nivel de estudios percibido por ciudad</h2>
                    <p class="card-sub">Respuestas apiladas: cada barra es una grabación.</p>
                    <div class="chart-box"><canvas data-chart="estudiosCiudad"></canvas></div>
                  </div>

                  <div class="card">
                    <h2 class="card-title">¿Trato diferenciado entre Mariam y Omar?</h2>
                    <p class="card-sub">Sí / No por ciudad.</p>
                    <div class="chart-box"><canvas data-chart="generoCiudad1"></canvas></div>
                  </div>
                  <div class="card">
                    <h2 class="card-title">¿Habría sido diferente con una jefa mujer?</h2>
                    <p class="card-sub">Sí / No por ciudad.</p>
                    <div class="chart-box"><canvas data-chart="generoCiudad2"></canvas></div>
                  </div>

                  <div class="card lg:col-span-2">
                    <h2 class="card-title">Región (comunidad autónoma) percibida · todas las grabaciones</h2>
                    <div class="chart-box chart-tall"><canvas data-chart="regionGlobal"></canvas></div>
                  </div>
                </div>

                <h2 class="section-title">Participantes</h2>
                <div class="grid gap-6 lg:grid-cols-3">
                  <div class="card">
                    <h2 class="card-title">Género de los participantes</h2>
                    <div class="chart-box"><canvas data-chart="generoP"></canvas></div>
                  </div>
                  <div class="card">
                    <h2 class="card-title">Nivel de español</h2>
                    <div class="chart-box"><canvas data-chart="nivelP"></canvas></div>
                  </div>
                  <div class="card">
                    <h2 class="card-title">Edad de los participantes</h2>
                    <div class="chart-box"><canvas data-chart="edadP"></canvas></div>
                  </div>
                </div>

                {stats.bloques.length > 1 && (
                  <>
                    <h2 class="section-title">Diseño del estudio</h2>
                    <div class="card">
                      <div class="flex flex-wrap items-center justify-between gap-2">
                        <h2 class="card-title">Equilibrio de escuchas por audio</h2>
                        <span class={`inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold ${stats.equilibrio.brecha <= 1 ? 'bg-emerald-100 text-emerald-700' : stats.equilibrio.brecha <= 3 ? 'bg-amber-100 text-amber-700' : 'bg-red-100 text-red-700'}`}>
                          Brecha máx–mín: {stats.equilibrio.brecha} ({stats.equilibrio.min}–{stats.equilibrio.max})
                        </span>
                      </div>
                      <p class="card-sub">
                        Nº de valoraciones que ha recibido cada grabación. El reparto
                        asigna a cada participante la versión menos usada, así que estas
                        cifras deberían mantenerse muy próximas entre sí (brecha ≈ 0-1).
                      </p>
                      {!stats.equilibrio.disenoEquilibrado && (
                        <p class="mt-2 rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-800">
                          ⚠️ El diseño de bloques no es equilibrado: alguna grabación
                          aparece en más formularios que otras. Revisa
                          <code class="rounded bg-amber-100 px-1">DEFINICION_BLOQUES</code>
                          en <code class="rounded bg-amber-100 px-1">src/lib/config.ts</code>.
                        </p>
                      )}
                      <div class="mt-3 grid grid-cols-2 gap-2 sm:grid-cols-3 lg:grid-cols-4">
                        {stats.equilibrio.porAudio.map((a) => (
                          <div class="flex items-center justify-between gap-2 rounded-lg border border-slate-100 bg-slate-50 px-3 py-2 text-sm">
                            <span class="min-w-0">
                              <span class="block truncate font-medium text-brand-700">
                                {a.numero}. {a.ciudad}
                              </span>
                              <span class="block text-xs text-slate-400">
                                {a.zona} · en {stats.equilibrio.replicas[a.numero] ?? 0} formularios
                              </span>
                            </span>
                            <span class="font-semibold text-slate-700">{a.n}</span>
                          </div>
                        ))}
                      </div>
                    </div>

                    <div class="card mt-6">
                      <h2 class="card-title">Diseño de bloques (BIBD) · reparto de participantes</h2>
                      <p class="card-sub">
                        Cada participante evalúa solo las grabaciones de su versión del
                        formulario, en el orden que se indica (hablas meridionales y
                        septentrionales alternadas). El reparto asigna siempre la versión
                        con menos participantes, de modo que todas las versiones —y con
                        ellas todas las grabaciones— reciban un número similar de respuestas.
                      </p>
                      <div class="mt-3 overflow-x-auto">
                        <table class="w-full text-sm">
                          <thead>
                            <tr class="border-b border-slate-200 text-left text-slate-500">
                              <th class="py-2 pr-4 font-medium">Versión</th>
                              <th class="py-2 pr-4 font-medium">Grabaciones (en orden)</th>
                              <th class="py-2 font-medium">Participantes</th>
                            </tr>
                          </thead>
                          <tbody>
                            {stats.bloques.map((b) => (
                              <tr class="border-b border-slate-100">
                                <td class="py-2 pr-4 font-semibold text-brand-700">F{b.version}</td>
                                <td class="py-2 pr-4 text-slate-600">{b.ciudades.join(' → ')}</td>
                                <td class="py-2 text-slate-700">{b.n}</td>
                              </tr>
                            ))}
                          </tbody>
                        </table>
                      </div>
                    </div>
                  </>
                )}
              </section>

              <section class="panel hidden" data-panel="cruces" role="tabpanel">
                <p class="panel-intro">
                  Aquí se cruza <strong>lo que valora cada persona</strong> con <strong>quién es esa
                  persona</strong> (nivel de español, edad, lengua materna, estancias en España…).
                  El «índice» de una escala es la media de todos sus adjetivos (1-5), y la
                  <strong>brecha</strong> es la resta
                  <span class="chip chip-sep">septentrional</span> −
                  <span class="chip chip-mer">meridional</span>: cuanto más lejos de 0, más
                  diferencia hace ese grupo entre las dos zonas dialectales.
                </p>

                <div class="grid min-w-0 gap-6">
                  {stats.cruces.indices.map((c) => (
                    <div class="card min-w-0">
                      <h2 class="card-title">{c.pregunta}</h2>
                      <p class="card-sub">{c.ayuda}</p>

                      <label class="mt-3 block text-sm font-medium text-slate-600">
                        Medida
                        <select
                          data-medida={c.id}
                          class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm sm:max-w-xs"
                        ></select>
                      </label>
                      <div class="chart-box chart-tall"><canvas data-chart={`cruce-${c.id}`}></canvas></div>

                      <div class="mt-4 overflow-x-auto">
                        <table class="tabla-cruce">
                          <thead>
                            <tr>
                              <th class="text-left">{c.variable}</th>
                              <th class="text-right">Particip.</th>
                              <th class="text-right">Valor.</th>
                              {MEDIDAS_TABLA.map((m) => (
                                <Fragment>
                                  <th class="text-right">{m.etiqueta} mer.</th>
                                  <th class="text-right">{m.etiqueta} sep.</th>
                                  <th class="text-right">Δ</th>
                                </Fragment>
                              ))}
                            </tr>
                          </thead>
                          <tbody>
                            {c.filas.map((f) => (
                              <tr>
                                <td class="font-semibold text-brand-700">{f.grupo}</td>
                                <td class="text-right text-slate-500">{f.nParticipantes}</td>
                                <td class="text-right text-slate-500">{f.total.n}</td>
                                {MEDIDAS_TABLA.map((m) => (
                                  <Fragment>
                                    <td class="text-right">{num(f.meridional[m.id])}</td>
                                    <td class="text-right">{num(f.septentrional[m.id])}</td>
                                    <td class={`text-right font-semibold ${claseDelta(f.brecha[m.id])}`}>
                                      {delta(f.brecha[m.id])}
                                    </td>
                                  </Fragment>
                                ))}
                              </tr>
                            ))}
                          </tbody>
                        </table>
                      </div>
                      <p class="nota-tabla">
                        mer. = media en las grabaciones meridionales · sep. = en las septentrionales ·
                        Δ = sep. − mer. (azul: prefiere la septentrional; naranja: la meridional).
                      </p>
                    </div>
                  ))}

                  <div class="card min-w-0">
                    <h2 class="card-title">{stats.cruces.genero.pregunta}</h2>
                    <p class="card-sub">{stats.cruces.genero.ayuda}</p>
                    <div class="chart-box"><canvas data-chart="cruceGenero"></canvas></div>
                    <div class="mt-4 overflow-x-auto">
                      <table class="tabla-cruce">
                        <thead>
                          <tr>
                            <th class="text-left">Género del participante</th>
                            <th class="text-right">Particip.</th>
                            <th class="text-right">Valor.</th>
                            <th class="text-right">Trato diferenciado · sí</th>
                            <th class="text-right">% sí</th>
                            <th class="text-right">Jefa mujer · sí</th>
                            <th class="text-right">% sí</th>
                          </tr>
                        </thead>
                        <tbody>
                          {stats.cruces.genero.filas.map((f) => (
                            <tr>
                              <td class="font-semibold text-brand-700">{f.grupo}</td>
                              <td class="text-right text-slate-500">{f.nParticipantes}</td>
                              <td class="text-right text-slate-500">{f.nValoraciones}</td>
                              <td class="text-right">{f.tratoDiferenciado.si} / {f.tratoDiferenciado.n}</td>
                              <td class="text-right font-semibold text-brand-700">{pct(f.tratoDiferenciado.pct)}</td>
                              <td class="text-right">{f.tratoMujerDiferente.si} / {f.tratoMujerDiferente.n}</td>
                              <td class="text-right font-semibold text-brand-700">{pct(f.tratoMujerDiferente.pct)}</td>
                            </tr>
                          ))}
                          <tr class="fila-total">
                            <td class="font-semibold">{stats.cruces.genero.total.grupo}</td>
                            <td class="text-right">{stats.cruces.genero.total.nParticipantes}</td>
                            <td class="text-right">{stats.cruces.genero.total.nValoraciones}</td>
                            <td class="text-right">
                              {stats.cruces.genero.total.tratoDiferenciado.si} / {stats.cruces.genero.total.tratoDiferenciado.n}
                            </td>
                            <td class="text-right font-semibold">{pct(stats.cruces.genero.total.tratoDiferenciado.pct)}</td>
                            <td class="text-right">
                              {stats.cruces.genero.total.tratoMujerDiferente.si} / {stats.cruces.genero.total.tratoMujerDiferente.n}
                            </td>
                            <td class="text-right font-semibold">{pct(stats.cruces.genero.total.tratoMujerDiferente.pct)}</td>
                          </tr>
                        </tbody>
                      </table>
                    </div>
                  </div>

                  <div class="card min-w-0">
                    <h2 class="card-title">{stats.cruces.correlacion.pregunta}</h2>
                    <p class="card-sub">{stats.cruces.correlacion.ayuda}</p>

                    <div class="mt-4 grid gap-3 grid-cols-2 lg:grid-cols-4">
                      {stats.cruces.correlacion.globales.map((c) => (
                        <div class="kpi kpi-sm">
                          <span class="kpi-val">{c.r === null ? '—' : c.r}</span>
                          <span class="kpi-label">{c.etiqueta} · r (n = {c.n})</span>
                        </div>
                      ))}
                      <div class="kpi kpi-sm">
                        <span class="kpi-val text-base leading-snug">
                          {interpretaR(stats.cruces.correlacion.globales[0]?.r ?? null)}
                        </span>
                        <span class="kpi-label">Lectura del r de la voz</span>
                      </div>
                    </div>

                    <div class="mt-6 grid gap-6 lg:grid-cols-2">
                      <div>
                        <p class="card-sub text-center">
                          Media del índice de voz en cada nivel de proximidad declarado.
                        </p>
                        <div class="chart-box"><canvas data-chart="vozPorProximidad"></canvas></div>
                      </div>
                      <div>
                        <p class="card-sub text-center">
                          Una valoración = un punto (con un pequeño desplazamiento horizontal para
                          que no se solapen).
                        </p>
                        <div class="chart-box"><canvas data-chart="nubeProximidad"></canvas></div>
                      </div>
                      <div class="lg:col-span-2">
                        <p class="card-sub text-center">
                          Correlación voz × proximidad dentro de cada grabación.
                        </p>
                        <div class="chart-box"><canvas data-chart="correlacionCiudad"></canvas></div>
                      </div>
                    </div>

                    <div class="mt-4 overflow-x-auto">
                      <table class="tabla-cruce">
                        <thead>
                          <tr>
                            <th class="text-left">Cruce</th>
                            <th class="text-right">r de Pearson</th>
                            <th class="text-right">n</th>
                            <th class="text-left">Lectura</th>
                          </tr>
                        </thead>
                        <tbody>
                          {[...stats.cruces.correlacion.globales, ...stats.cruces.correlacion.porZona].map((c) => (
                            <tr>
                              <td class="font-semibold text-brand-700">{c.etiqueta}</td>
                              <td class="text-right font-semibold">{c.r === null ? '—' : c.r}</td>
                              <td class="text-right text-slate-500">{c.n}</td>
                              <td class="text-slate-500">{interpretaR(c.r)}</td>
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    </div>
                  </div>
                </div>
              </section>

              {stats.porGrabacion.map((g) => (
                <section class="panel hidden" data-panel={g.slug} data-numero={g.numero} role="tabpanel">
                  <div class="flex flex-wrap items-baseline justify-between gap-2">
                    <h2 class="font-display text-xl font-bold text-brand-950">
                      {g.numero}. {g.ciudad}
                      <span class="ml-2 align-middle text-sm font-medium text-slate-400">
                        {g.comunidad} · habla {g.zona}
                      </span>
                    </h2>
                    <span class="text-sm text-slate-500">{g.n} valoraciones</span>
                  </div>

                  {g.n === 0 ? (
                    <div class="mt-6 rounded-2xl border border-dashed border-slate-300 bg-white p-10 text-center text-slate-500">
                      Esta grabación todavía no ha recibido ninguna valoración.
                    </div>
                  ) : (
                    <>
                      <div class="mt-4 grid gap-3 grid-cols-2 lg:grid-cols-5">
                        <div class="kpi kpi-sm">
                          <span class="kpi-val">{g.mediaVozGlobal}</span>
                          <span class="kpi-label">Voz (1-5)</span>
                        </div>
                        <div class="kpi kpi-sm">
                          <span class="kpi-val">{g.mediaPersonaGlobal}</span>
                          <span class="kpi-label">Persona (1-5)</span>
                        </div>
                        <div class="kpi kpi-sm">
                          <span class="kpi-val">{g.mediaCulturaGlobal}</span>
                          <span class="kpi-label">Cultura (1-5)</span>
                        </div>
                        <div class="kpi kpi-sm">
                          <span class="kpi-val">{g.proximidad}</span>
                          <span class="kpi-label">Proximidad (1-5)</span>
                        </div>
                        <div class="kpi kpi-sm">
                          <span class="kpi-val">{g.acierto.porcentaje}%</span>
                          <span class="kpi-label">Acierta {g.comunidad}</span>
                        </div>
                      </div>

                      <div class="mt-6 grid gap-6 lg:grid-cols-2">
                        <div class="card lg:col-span-2">
                          <h3 class="card-title">Perfil de la voz</h3>
                          <p class="card-sub">
                            Media de cada par de adjetivos en esta grabación, con la media de
                            todas las grabaciones al lado para situarla.
                          </p>
                          <div class="chart-box chart-tall"><canvas data-chart="voz"></canvas></div>
                        </div>

                        <div class="card">
                          <h3 class="card-title">Percepción de la persona</h3>
                          <p class="card-sub">Diferencial semántico de la persona que habla.</p>
                          <div class="chart-box"><canvas data-chart="persona"></canvas></div>
                        </div>

                        <div class="card">
                          <h3 class="card-title">Percepción de la cultura</h3>
                          <p class="card-sub">Diferencial semántico de la cultura atribuida.</p>
                          <div class="chart-box"><canvas data-chart="cultura"></canvas></div>
                        </div>

                        <div class="card">
                          <h3 class="card-title">Proximidad con la propia pronunciación</h3>
                          <p class="card-sub">1 = totalmente diferente · 5 = idéntica.</p>
                          <div class="chart-box"><canvas data-chart="proximidad"></canvas></div>
                        </div>

                        <div class="card">
                          <h3 class="card-title">Región percibida</h3>
                          <p class="card-sub">
                            En verde, la comunidad real del habla ({g.comunidad}).
                          </p>
                          <div class="chart-box"><canvas data-chart="region"></canvas></div>
                        </div>

                        <div class="card">
                          <h3 class="card-title">Nivel de ingresos percibido</h3>
                          <div class="chart-box"><canvas data-chart="ingresos"></canvas></div>
                        </div>
                        <div class="card">
                          <h3 class="card-title">Nivel de estudios percibido</h3>
                          <div class="chart-box"><canvas data-chart="estudios"></canvas></div>
                        </div>

                        <div class="card lg:col-span-2">
                          <h3 class="card-title">Preguntas sobre el género de quien habla</h3>
                          <div class="grid gap-6 sm:grid-cols-2">
                            <div>
                              <p class="card-sub text-center">¿Trato diferenciado entre Mariam y Omar?</p>
                              <div class="chart-box"><canvas data-chart="trato1"></canvas></div>
                            </div>
                            <div>
                              <p class="card-sub text-center">¿Habría sido diferente con una jefa mujer?</p>
                              <div class="chart-box"><canvas data-chart="trato2"></canvas></div>
                            </div>
                          </div>
                        </div>
                      </div>
                    </>
                  )}
                </section>
              ))}
            </div>
          </>
        )
      }
    </main>
  </div>

  <script type="application/json" id="stats-data" set:html={JSON.stringify(stats)}></script>

  <script>
    import Chart from 'chart.js/auto';

    const BRAND = '#1f66f0';
    const ACCENT = '#ff7a2f';
    const VERDE = '#22c55e';
    const GRIS = '#cbd5e1';
    const PALETTE = ['#1f66f0', '#ff7a2f', '#22c55e', '#a855f7', '#eab308', '#06b6d4', '#ef4444', '#64748b'];
    // Meridional / septentrional: mismo código de color en todas las gráficas.
    const COLOR_ZONA = { meridional: ACCENT, septentrional: BRAND } as Record<string, string>;

    const el = document.getElementById('stats-data');
    if (el && el.textContent) init(JSON.parse(el.textContent));

    function init(stats: any) {
      Chart.defaults.font.family = 'Inter, system-ui, sans-serif';
      Chart.defaults.color = '#475569';

      const contenedor = document.getElementById('tabs');
      if (!contenedor) return;

      const tabs = Array.from(contenedor.querySelectorAll<HTMLButtonElement>('.tab'));
      const paneles = Array.from(contenedor.querySelectorAll<HTMLElement>('.panel'));
      // Las gráficas de un panel oculto se dibujarían con tamaño 0, así que
      // cada pestaña se pinta la primera vez que se abre (y solo una vez).
      const pintados = new Set<string>();

      function abrir(nombre: string) {
        const existe = paneles.some((p) => p.dataset.panel === nombre);
        const destino = existe ? nombre : 'global';
        paneles.forEach((p) => p.classList.toggle('hidden', p.dataset.panel !== destino));
        tabs.forEach((t) => t.setAttribute('aria-selected', String(t.dataset.tab === destino)));
        if (!pintados.has(destino)) {
          pintados.add(destino);
          if (destino === 'global') pintarGlobal(stats);
          else if (destino === 'cruces') pintarCruces(stats);
          else pintarCiudad(stats, destino);
        }
      }

      tabs.forEach((t) => {
        t.addEventListener('click', () => {
          const nombre = t.dataset.tab!;
          abrir(nombre);
          // El ancla permite compartir «/admin#granada» y sobrevive a un F5.
          const base = location.pathname + location.search;
          history.replaceState(null, '', nombre === 'global' ? base : `${base}#${nombre}`);
        });
      });

      window.addEventListener('hashchange', () => abrir(location.hash.slice(1) || 'global'));
      abrir(location.hash.slice(1) || 'global');
    }

    // ── Pestaña global: todo cruza ciudades ────────────────────────────────
    function pintarGlobal(stats: any) {
      const panel = panelDe('global');
      const c = stats.comparativa;
      const coloresZona = c.zonas.map((z: string) => COLOR_ZONA[z] ?? BRAND);

      new Chart(canvas(panel, 'ranking'), {
        type: 'bar',
        data: {
          labels: stats.ranking.map((g: any) => g.etiqueta),
          datasets: [{
            label: 'Agradabilidad de la voz',
            data: stats.ranking.map((g: any) => g.mediaVozGlobal),
            backgroundColor: stats.ranking.map((g: any) => COLOR_ZONA[g.zona] ?? BRAND),
            borderRadius: 6,
          }],
        },
        options: {
          indexAxis: 'y',
          responsive: true, maintainAspectRatio: false,
          plugins: { legend: { display: false }, tooltip: { callbacks: { afterLabel: (i: any) => `n = ${stats.ranking[i.dataIndex].n}` } } },
          scales: { x: escala15() },
        },
      });

      new Chart(canvas(panel, 'medias'), {
        type: 'bar',
        data: {
          labels: c.ciudades,
          datasets: [
            { label: 'Voz', data: c.medias.voz, backgroundColor: PALETTE[0], borderRadius: 4 },
            { label: 'Persona', data: c.medias.persona, backgroundColor: PALETTE[1], borderRadius: 4 },
            { label: 'Cultura', data: c.medias.cultura, backgroundColor: PALETTE[2], borderRadius: 4 },
            { label: 'Proximidad', data: c.medias.proximidad, backgroundColor: PALETTE[3], borderRadius: 4 },
          ],
        },
        options: {
          responsive: true, maintainAspectRatio: false,
          plugins: { legend: { position: 'bottom' } },
          scales: { y: escala15() },
        },
      });

      // Selector de rasgo: una barra por ciudad para el adjetivo elegido.
      const select = panel.querySelector<HTMLSelectElement>('select[data-select="rasgo"]')!;
      const grupos: [string, any[]][] = [
        ['Voz', c.vozPorItem],
        ['Persona', c.personaPorItem],
        ['Cultura', c.culturaPorItem],
      ];
      const rasgos: any[] = [];
      for (const [nombre, items] of grupos) {
        const og = document.createElement('optgroup');
        og.label = nombre;
        items.forEach((it: any) => {
          const opt = document.createElement('option');
          opt.value = String(rasgos.length);
          opt.textContent = `${it.etiqueta}`;
          og.appendChild(opt);
          rasgos.push(it);
        });
        select.appendChild(og);
      }

      const chartRasgo = new Chart(canvas(panel, 'rasgo'), {
        type: 'bar',
        data: {
          labels: c.ciudades,
          datasets: [{ label: rasgos[0].etiqueta, data: rasgos[0].data, backgroundColor: coloresZona, borderRadius: 5 }],
        },
        options: {
          responsive: true, maintainAspectRatio: false,
          plugins: { legend: { display: false } },
          scales: { y: escala15() },
        },
      });
      select.addEventListener('change', () => {
        const r = rasgos[Number(select.value)];
        chartRasgo.data.datasets[0].label = r.etiqueta;
        chartRasgo.data.datasets[0].data = r.data;
        chartRasgo.update();
      });

      radarZona(canvas(panel, 'radarVoz'), c.zona.meridional.voz, c.zona.septentrional.voz);
      radarZona(canvas(panel, 'radarPersona'), c.zona.meridional.persona, c.zona.septentrional.persona);
      radarZona(canvas(panel, 'radarCultura'), c.zona.meridional.cultura, c.zona.septentrional.cultura);

      new Chart(canvas(panel, 'proximidadCiudad'), {
        type: 'bar',
        data: { labels: c.ciudades, datasets: [{ data: c.medias.proximidad, backgroundColor: coloresZona, borderRadius: 5 }] },
        options: {
          responsive: true, maintainAspectRatio: false,
          plugins: { legend: { display: false } },
          scales: { y: escala15() },
        },
      });

      new Chart(canvas(panel, 'acierto'), {
        type: 'bar',
        data: { labels: c.ciudades, datasets: [{ data: c.aciertoRegion, backgroundColor: coloresZona, borderRadius: 5 }] },
        options: {
          responsive: true, maintainAspectRatio: false,
          plugins: { legend: { display: false }, tooltip: { callbacks: { label: (i: any) => `${i.raw}% de aciertos` } } },
          scales: { y: { min: 0, max: 100, ticks: { callback: (v: any) => `${v}%` } } },
        },
      });

      apilada(canvas(panel, 'ingresosCiudad'), c.ciudades, c.ingresosPorCiudad);
      apilada(canvas(panel, 'estudiosCiudad'), c.ciudades, c.estudiosPorCiudad);

      siNoApilado(canvas(panel, 'generoCiudad1'), c.ciudades, c.generoPorCiudad.tratoDiferenciado);
      siNoApilado(canvas(panel, 'generoCiudad2'), c.ciudades, c.generoPorCiudad.tratoMujerDiferente);

      const reg = sinCeros(stats.global.regionPercibida);
      new Chart(canvas(panel, 'regionGlobal'), {
        type: 'bar',
        data: { labels: reg.labels, datasets: [{ data: reg.data, backgroundColor: PALETTE[3], borderRadius: 5 }] },
        options: { ...barraBase(), indexAxis: 'y' },
      });

      doughnut(canvas(panel, 'generoP'), stats.demografia.genero);
      new Chart(canvas(panel, 'nivelP'), {
        type: 'bar',
        data: { labels: stats.demografia.nivelEspanol.labels, datasets: [{ data: stats.demografia.nivelEspanol.data, backgroundColor: BRAND, borderRadius: 6 }] },
        options: barraBase(),
      });
      new Chart(canvas(panel, 'edadP'), {
        type: 'bar',
        data: { labels: stats.demografia.tramos, datasets: [{ data: stats.demografia.edadHist, backgroundColor: PALETTE[2], borderRadius: 6 }] },
        options: barraBase(),
      });
    }

    // ── Pestaña de cruces: perfil del participante × valoración ────────────
    const MEDIDAS = [
      { id: 'voz', etiqueta: 'Índice de voz' },
      { id: 'persona', etiqueta: 'Índice de persona' },
      { id: 'cultura', etiqueta: 'Índice de cultura' },
      { id: 'proximidad', etiqueta: 'Proximidad' },
    ];

    function pintarCruces(stats: any) {
      const panel = panelDe('cruces');
      const cr = stats.cruces;

      cr.indices.forEach((c: any) => pintarCruce(panel, c));

      // % de síes en las dos preguntas de género, según el género del participante.
      const g = cr.genero;
      new Chart(canvas(panel, 'cruceGenero'), {
        type: 'bar',
        data: {
          labels: g.filas.map((f: any) => f.grupo),
          datasets: [
            {
              label: '¿Trato diferenciado entre Mariam y Omar?',
              data: g.filas.map((f: any) => f.tratoDiferenciado.pct),
              backgroundColor: PALETTE[0],
              borderRadius: 5,
            },
            {
              label: '¿Habría sido diferente con una jefa mujer?',
              data: g.filas.map((f: any) => f.tratoMujerDiferente.pct),
              backgroundColor: PALETTE[1],
              borderRadius: 5,
            },
          ],
        },
        options: {
          responsive: true, maintainAspectRatio: false,
          plugins: {
            legend: { position: 'bottom' },
            tooltip: {
              callbacks: {
                label: (i: any) => `${i.dataset.label}: ${i.raw}% de síes`,
                afterLabel: (i: any) => `n = ${g.filas[i.dataIndex].nValoraciones} valoraciones`,
              },
            },
          },
          scales: { y: { min: 0, max: 100, ticks: { callback: (v: any) => `${v}%` } } },
        },
      });

      // Índice de voz medio en cada nivel de la escala de proximidad.
      const vp = cr.correlacion.vozPorProximidad;
      new Chart(canvas(panel, 'vozPorProximidad'), {
        type: 'bar',
        data: {
          labels: vp.map((x: any) => `Proximidad ${x.proximidad}`),
          datasets: [
            { label: 'Voz', data: vp.map((x: any) => x.voz), backgroundColor: PALETTE[0], borderRadius: 5 },
            { label: 'Persona', data: vp.map((x: any) => x.persona), backgroundColor: PALETTE[1], borderRadius: 5 },
            { label: 'Cultura', data: vp.map((x: any) => x.cultura), backgroundColor: PALETTE[2], borderRadius: 5 },
          ],
        },
        options: {
          responsive: true, maintainAspectRatio: false,
          plugins: {
            legend: { position: 'bottom' },
            tooltip: { callbacks: { afterLabel: (i: any) => `n = ${vp[i.dataIndex].n}` } },
          },
          scales: { y: escala15() },
        },
      });

      // Nube de puntos con un jitter horizontal: la proximidad es una escala de
      // 1 a 5, así que sin desplazar los puntos se apilarían en cinco columnas.
      const jitter = (x: number) => x + (Math.random() - 0.5) * 0.55;
      const nube = cr.correlacion.nube;
      const porZona = (z: string) =>
        nube.filter((p: any) => p.zona === z).map((p: any) => ({ x: jitter(p.x), y: p.y }));
      new Chart(canvas(panel, 'nubeProximidad'), {
        type: 'scatter',
        data: {
          datasets: [
            { label: 'Meridional', data: porZona('meridional'), backgroundColor: 'rgba(255,122,47,0.45)' },
            { label: 'Septentrional', data: porZona('septentrional'), backgroundColor: 'rgba(31,102,240,0.45)' },
          ],
        },
        options: {
          responsive: true, maintainAspectRatio: false,
          plugins: {
            legend: { position: 'bottom' },
            tooltip: {
              callbacks: {
                label: (i: any) => `proximidad ≈ ${Math.round(i.parsed.x)} · voz ${i.parsed.y.toFixed(2)}`,
              },
            },
          },
          scales: {
            x: { min: 0.5, max: 5.5, title: { display: true, text: 'Proximidad declarada (1-5)' }, ticks: { stepSize: 1 } },
            y: { ...escala15(), title: { display: true, text: 'Índice de voz (1-5)' } },
          },
        },
      });

      // r de Pearson dentro de cada grabación.
      const pc = cr.correlacion.porCiudad;
      new Chart(canvas(panel, 'correlacionCiudad'), {
        type: 'bar',
        data: {
          labels: pc.map((x: any) => x.ciudad),
          datasets: [{
            data: pc.map((x: any) => x.r),
            backgroundColor: pc.map((x: any) => COLOR_ZONA[x.zona] ?? BRAND),
            borderRadius: 5,
          }],
        },
        options: {
          responsive: true, maintainAspectRatio: false,
          plugins: {
            legend: { display: false },
            tooltip: { callbacks: { afterLabel: (i: any) => `n = ${pc[i.dataIndex].n}` } },
          },
          scales: { y: { min: -1, max: 1, ticks: { stepSize: 0.5 } } },
        },
      });
    }

    /**
     * Una tarjeta de cruce: barras meridional/septentrional por grupo y, en el
     * eje derecho, la brecha entre ambas (la medida de «discriminación»).
     */
    function pintarCruce(panel: HTMLElement, c: any) {
      const select = panel.querySelector<HTMLSelectElement>(`select[data-medida="${c.id}"]`);
      const cv = canvas(panel, `cruce-${c.id}`);
      if (!select || !cv) return;

      MEDIDAS.forEach((m, i) => {
        const opt = document.createElement('option');
        opt.value = String(i);
        opt.textContent = m.etiqueta;
        select.appendChild(opt);
      });

      const serie = (zona: 'meridional' | 'septentrional', medida: string) =>
        c.filas.map((f: any) => f[zona][medida]);
      const brechas = (medida: string) => c.filas.map((f: any) => f.brecha[medida]);

      const chart = new Chart(cv, {
        type: 'bar',
        data: {
          labels: c.filas.map((f: any) => f.grupo),
          datasets: [
            { label: 'Meridional', data: serie('meridional', 'voz'), backgroundColor: ACCENT, borderRadius: 5, order: 2 },
            { label: 'Septentrional', data: serie('septentrional', 'voz'), backgroundColor: BRAND, borderRadius: 5, order: 2 },
            {
              label: 'Brecha (sep. − mer.)',
              type: 'line',
              data: brechas('voz'),
              borderColor: '#7c3aed',
              backgroundColor: '#7c3aed',
              borderWidth: 2,
              tension: 0.25,
              yAxisID: 'y1',
              order: 1,
            },
          ],
        },
        options: {
          responsive: true, maintainAspectRatio: false,
          plugins: {
            legend: { position: 'bottom' },
            tooltip: {
              callbacks: {
                afterLabel: (i: any) =>
                  `n = ${c.filas[i.dataIndex].total.n} valoraciones · ${c.filas[i.dataIndex].nParticipantes} participantes`,
              },
            },
          },
          scales: {
            y: { ...escala15(), title: { display: true, text: 'Media (1-5)' } },
            y1: {
              position: 'right',
              suggestedMin: -0.6,
              suggestedMax: 0.6,
              grid: { drawOnChartArea: false },
              title: { display: true, text: 'Brecha' },
            },
          },
        },
      });

      select.addEventListener('change', () => {
        const m = MEDIDAS[Number(select.value)];
        chart.data.datasets[0].data = serie('meridional', m.id);
        chart.data.datasets[1].data = serie('septentrional', m.id);
        chart.data.datasets[2].data = brechas(m.id);
        chart.update();
      });
    }

    // ── Pestaña de una ciudad ──────────────────────────────────────────────
    function pintarCiudad(stats: any, slug: string) {
      const panel = panelDe(slug);
      const g = stats.porGrabacion.find((x: any) => x.slug === slug);
      if (!g || g.n === 0) return;
      const color = COLOR_ZONA[g.zona] ?? BRAND;

      diferencialComparado(canvas(panel, 'voz'), g.voz, stats.global.voz, g.ciudad, color);
      diferencialComparado(canvas(panel, 'persona'), g.persona, stats.global.persona, g.ciudad, color);
      diferencialComparado(canvas(panel, 'cultura'), g.cultura, stats.global.cultura, g.ciudad, color);

      new Chart(canvas(panel, 'proximidad'), {
        type: 'bar',
        data: { labels: g.proximidadDist.labels, datasets: [{ data: g.proximidadDist.data, backgroundColor: ACCENT, borderRadius: 6 }] },
        options: barraBase(),
      });

      // Región percibida: se destaca en verde la comunidad real del habla.
      const reg = sinCeros(g.regionPercibida);
      new Chart(canvas(panel, 'region'), {
        type: 'bar',
        data: {
          labels: reg.labels,
          datasets: [{
            data: reg.data,
            backgroundColor: reg.labels.map((l: string) => (l === g.comunidad ? VERDE : GRIS)),
            borderRadius: 5,
          }],
        },
        options: { ...barraBase(), indexAxis: 'y' },
      });

      doughnut(canvas(panel, 'ingresos'), g.ingresos);
      doughnut(canvas(panel, 'estudios'), g.estudios);
      siNo(canvas(panel, 'trato1'), g.genero.tratoDiferenciado);
      siNo(canvas(panel, 'trato2'), g.genero.tratoMujerDiferente);
    }

    // ── Utilidades de dibujo ───────────────────────────────────────────────
    function panelDe(nombre: string) {
      return document.querySelector<HTMLElement>(`.panel[data-panel="${nombre}"]`)!;
    }
    function canvas(panel: HTMLElement, nombre: string) {
      return panel.querySelector(`canvas[data-chart="${nombre}"]`) as HTMLCanvasElement;
    }
    function escala15() {
      return { min: 1, max: 5, ticks: { stepSize: 1 } } as any;
    }
    function barraBase() {
      return {
        responsive: true, maintainAspectRatio: false,
        plugins: { legend: { display: false } },
        scales: { y: { beginAtZero: true, ticks: { precision: 0 } } },
      } as any;
    }

    /** Barras de una ciudad contra la media de todas (para situar el dato). */
    function diferencialComparado(cv: HTMLCanvasElement, items: any[], global: any[], ciudad: string, color: string) {
      new Chart(cv, {
        type: 'bar',
        data: {
          labels: items.map((x) => x.etiqueta),
          datasets: [
            { label: ciudad, data: items.map((x) => x.media), backgroundColor: color, borderRadius: 5 },
            { label: 'Media de las 12', data: global.map((x) => x.media), backgroundColor: GRIS, borderRadius: 5 },
          ],
        },
        options: {
          indexAxis: 'y',
          responsive: true, maintainAspectRatio: false,
          plugins: { legend: { position: 'bottom' } },
          scales: { x: escala15() },
        },
      });
    }

    function radarZona(cv: HTMLCanvasElement, meridional: any[], septentrional: any[]) {
      new Chart(cv, {
        type: 'radar',
        data: {
          labels: meridional.map((x) => x.positivo),
          datasets: [
            { label: 'Meridional', data: meridional.map((x) => x.media), borderColor: ACCENT, backgroundColor: 'rgba(255,122,47,0.15)', pointBackgroundColor: ACCENT },
            { label: 'Septentrional', data: septentrional.map((x) => x.media), borderColor: BRAND, backgroundColor: 'rgba(31,102,240,0.15)', pointBackgroundColor: BRAND },
          ],
        },
        options: {
          responsive: true, maintainAspectRatio: false,
          plugins: { legend: { position: 'bottom' } },
          scales: { r: { min: 1, max: 5, ticks: { stepSize: 1 } } },
        },
      });
    }

    function apilada(cv: HTMLCanvasElement, ciudades: string[], series: any[]) {
      new Chart(cv, {
        type: 'bar',
        data: {
          labels: ciudades,
          datasets: series.map((s: any, i: number) => ({
            label: s.nivel,
            data: s.data,
            backgroundColor: PALETTE[i % PALETTE.length],
          })),
        },
        options: {
          responsive: true, maintainAspectRatio: false,
          plugins: { legend: { position: 'bottom' } },
          scales: { x: { stacked: true }, y: { stacked: true, beginAtZero: true, ticks: { precision: 0 } } },
        },
      });
    }

    function siNoApilado(cv: HTMLCanvasElement, ciudades: string[], v: { si: number[]; no: number[] }) {
      new Chart(cv, {
        type: 'bar',
        data: {
          labels: ciudades,
          datasets: [
            { label: 'Sí', data: v.si, backgroundColor: VERDE },
            { label: 'No', data: v.no, backgroundColor: '#ef4444' },
          ],
        },
        options: {
          responsive: true, maintainAspectRatio: false,
          plugins: { legend: { position: 'bottom' } },
          scales: { x: { stacked: true }, y: { stacked: true, beginAtZero: true, ticks: { precision: 0 } } },
        },
      });
    }

    function doughnut(cv: HTMLCanvasElement, dist: { labels: string[]; data: number[] }) {
      const f = sinCeros(dist);
      new Chart(cv, {
        type: 'doughnut',
        data: { labels: f.labels, datasets: [{ data: f.data, backgroundColor: PALETTE }] },
        options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom' } } },
      });
    }

    function siNo(cv: HTMLCanvasElement, v: { si: number; no: number }) {
      new Chart(cv, {
        type: 'doughnut',
        data: { labels: ['Sí', 'No'], datasets: [{ data: [v.si, v.no], backgroundColor: [VERDE, '#ef4444'] }] },
        options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom' } } },
      });
    }

    function sinCeros(dist: { labels: string[]; data: number[] }) {
      const labels: string[] = [], data: number[] = [];
      dist.labels.forEach((l, i) => {
        if (dist.data[i] > 0) { labels.push(l); data.push(dist.data[i]); }
      });
      return { labels, data };
    }
  </script>


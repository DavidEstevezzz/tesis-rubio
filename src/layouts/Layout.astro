---
export interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Estudio Sociolingüístico',
  description = 'Formulario de investigación sobre actitudes lingüísticas y el uso del español en distintos contextos sociales.',
} = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E%F0%9F%97%A3%EF%B8%8F%3C/text%3E%3C/svg%3E" />
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-800 antialiased">
    <slot />
    <style is:global>
      :root {
        color-scheme: light;
      }
      body {
        font-family: 'Inter', system-ui, sans-serif;
      }
      /* Scrollbar sutil en el diferencial semántico */
      .thin-scroll::-webkit-scrollbar {
        height: 8px;
      }
      .thin-scroll::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 9999px;
      }

      /* ── Utilidades de formulario (compartidas por los componentes) ── */
      .field {
        margin-top: 1.75rem;
      }
      .field-title {
        display: block;
        font-weight: 600;
        color: #1d3c8d;
        font-size: 1rem;
        line-height: 1.4;
      }
      .field-help {
        margin-top: 0.25rem;
        margin-bottom: 0.75rem;
        font-size: 0.85rem;
        color: #64748b;
      }
      .req {
        color: #f45f12;
        margin-left: 0.15rem;
      }
      .input {
        margin-top: 0.5rem;
        width: 100%;
        border-radius: 0.75rem;
        border: 1px solid #cbd5e1;
        background: #fff;
        padding: 0.65rem 0.85rem;
        font-size: 0.95rem;
        color: #1e293b;
        transition: border-color 0.15s, box-shadow 0.15s;
      }
      .input:focus {
        outline: none;
        border-color: #1f66f0;
        box-shadow: 0 0 0 4px rgba(31, 102, 240, 0.12);
      }
      textarea.input {
        min-height: 7rem;
        resize: vertical;
      }
      .pills {
        margin-top: 0.6rem;
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
      }
      .pill {
        cursor: pointer;
      }
      .pill > span {
        display: inline-flex;
        align-items: center;
        border-radius: 9999px;
        border: 1px solid #cbd5e1;
        background: #fff;
        padding: 0.5rem 1.1rem;
        font-size: 0.9rem;
        font-weight: 500;
        color: #334155;
        transition: all 0.12s ease;
      }
      .pill:hover > span {
        border-color: #59a6ff;
      }
      .pill .peer:checked ~ span,
      .pill > .peer:checked + span {
        background: #1f66f0;
        border-color: #1f66f0;
        color: #fff;
        box-shadow: 0 6px 16px -8px rgba(31, 102, 240, 0.7);
      }
      .pill .peer:focus-visible + span {
        outline: 2px solid #1f66f0;
        outline-offset: 2px;
      }
      /* Chips (más pequeños que los pills): idiomas, etc. */
      .idioma-row {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.4rem 0.6rem;
        border: 1px solid #e2e8f0;
        background: #fff;
        border-radius: 0.85rem;
        padding: 0.55rem 0.75rem;
      }
      .idioma-name {
        flex: 0 0 5rem;
        font-weight: 600;
        font-size: 0.9rem;
        color: #1a51dd;
      }
      .chips {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        flex: 1 1 auto;
      }
      .chip {
        cursor: pointer;
      }
      .chip > span {
        display: inline-flex;
        align-items: center;
        border-radius: 9999px;
        border: 1px solid #cbd5e1;
        background: #fff;
        padding: 0.3rem 0.7rem;
        font-size: 0.8rem;
        font-weight: 500;
        color: #475569;
        transition: all 0.12s ease;
      }
      .chip:hover > span {
        border-color: #59a6ff;
      }
      .chip > .peer:checked + span {
        background: #1f66f0;
        border-color: #1f66f0;
        color: #fff;
        box-shadow: 0 4px 12px -6px rgba(31, 102, 240, 0.7);
      }
      .chip > .peer:focus-visible + span {
        outline: 2px solid #1f66f0;
        outline-offset: 2px;
      }
      /* Proximidad (círculos numerados) */
      .prox {
        cursor: pointer;
      }
      .prox-dot {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 2.4rem;
        height: 2.4rem;
        border-radius: 9999px;
        border: 2px solid #cbd5e1;
        background: #fff;
        font-weight: 700;
        color: #64748b;
        transition: all 0.12s ease;
      }
      .prox:hover .prox-dot {
        border-color: #59a6ff;
      }
      .prox .peer:checked + .prox-dot {
        background: #1f66f0;
        border-color: #1f66f0;
        color: #fff;
        transform: scale(1.06);
      }
      .prox .peer:focus-visible + .prox-dot {
        outline: 2px solid #1f66f0;
        outline-offset: 2px;
      }
      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }
      /* ── Validación: resaltar en rojo lo que falta ── */
      /* Campos de texto / selectores / áreas de texto */
      .input.field-error {
        border-color: #ef4444 !important;
        box-shadow: 0 0 0 4px rgba(239, 68, 68, 0.14);
      }
      /* Grupos sin responder: tiñe de rojo sus marcadores (círculos/botones) */
      .row-error .pill > span {
        border-color: #ef4444;
        color: #b91c1c;
      }
      .row-error .dot,
      .row-error .prox-dot,
      .row-error .frec-dot,
      .row-error .dot-mini {
        border-color: #ef4444;
        box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.12);
      }
      /* Fila de la escala (diferencial semántico) sin responder */
      fieldset.diferencial-row.row-error {
        border-color: #ef4444 !important;
        background: #fff5f5;
      }
      .prox-group.row-error {
        border-radius: 0.75rem;
        outline: 2px dashed #fca5a5;
        outline-offset: 6px;
      }
      /* Etiqueta del apartado con error, para que "salte a la vista" */
      .field-error > .field-title,
      .field-error > label.field-title {
        color: #b91c1c;
      }
      /* Mensaje de aviso */
      .error-msg {
        display: none;
        margin-top: 0.5rem;
        font-size: 0.82rem;
        font-weight: 600;
        color: #dc2626;
      }
      .error-msg span[aria-hidden] {
        margin-right: 0.15rem;
      }
    </style>
  </body>
</html>
